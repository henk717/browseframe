{
  "name": "browseframe",
  "version": "1.1.0",
  "description": "A minimal chromium-based browser for locked-down Linux systems",
  "homepage": "https://github.com/henk717/uftc",
  "main": "main.js",
  "scripts": {
    "start": "electron . ",
    "build": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "browser",
    "chromium",
    "electron",
    "minimal"
  ],
  "author": {
    "name": "BrowseFrame Developer",
    "email": "no@email.provided"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.browseframe.browser",
    "productName": "BrowseFrame",
    "files": [
      "main.js",
      "system-ca.js",
      "preload.js",
      "blank.html",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "executableName": "browseframe",
      "icon": "icon.png",
      "maintainer": "no@email.provided",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "synopsis": "Minimal locked-down browser",
      "description": "BrowseFrame is a hardened, minimal browser designed for secure Linux environments.",
      "desktop": {
        "entry": {
          "Name": "BrowseFrame",
          "Comment": "Minimal locked-down browser",
          "Categories": "Network;WebBrowser;",
          "MimeType": "x-scheme-handler/http;x-scheme-handler/https;",
          "StartupNotify": "true",
          "Terminal": "false",
          "Type": "Application"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "afterInstall": "build/deb/postinst",
      "afterRemove": "build/deb/postrm",
      "depends": [
        "openssl",
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "desktopName": "browseframe.desktop"
}
